# Obligatorias
DISCORD_TOKEN=TU_DISCORD_TOKEN
N8N_WEBHOOK_URL=https://tu-n8n.ejemplo.com/webhook/discord-audio
OPENAI_API_KEY=TU_OPENAI_API_KEY

# Transcripción (opcionales, se muestran los defaults)
TRANSCRIBE_MODEL=gpt-4o-transcribe
TRANSCRIBE_BASE_URL=https://api.openai.com/v1
# TRANSCRIBE_API_KEY=TU_TRANSCRIBE_API_KEY
TRANSCRIBE_LANGUAGE=es
TRANSCRIBE_PROMPT=Reunión de equipo de desarrollo. Términos: NombreProducto, Cliente, Proyecto.

# Filtrado de alucinaciones e idioma (opcionales)
LANG_FILTER=1
SHORT_UTTERANCE_MAX_WORDS=2
SPANISH_EXTRA_ALLOWLIST=

# Respaldo local y health check (opcionales)
FAILED_PAYLOAD_DIR=failed_payloads
PORT=8080
